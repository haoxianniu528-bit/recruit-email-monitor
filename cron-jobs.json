# OpenClaw 定时任务配置
# 导入方法：openclaw cron import /path/to/this/file
# ⚠️ 请把 user:YOUR_FEISHU_USER_ID 替换为你的飞书用户 ID（config.json 中的 feishu_target）
# ⚠️ 两个任务均使用 isolated 会话 + announce 投递，不要改回 main 会话 systemEvent
#    （main 会话事件依赖 heartbeat 处理，且脚本内调用 openclaw message send 会因会话文件锁失败）
# ⚠️ 每日简报已迁移为「系统 crontab 直发飞书 API」（不经 LLM，永不因模型超时失败），
#    下方简报任务仅作备选/参考，默认应禁用或不用。

{
  "version": 1,
  "jobs": [
    {
      "id": "recruit-email-hourly-check",
      "name": "招聘邮件检查（Agent 判定）",
      "enabled": true,
      "schedule": {
        "kind": "cron",
        "expr": "0 * * * *",
        "staggerMs": 300000
      },
      "description": "每小时拉取未处理邮件，由 Agent 逐封判断是否为招聘邮件并记录到表格",
      "sessionTarget": "isolated",
      "payload": {
        "kind": "agentTurn",
        "message": "运行招聘邮件监控检查（Agent 判定模式）：1) cd <skill-dir> && python3 scripts/fetch-emails.py 拉取未处理邮件候选；2) 读取 scripts/pending_candidates.json，逐封自行判断是否为招聘邮件，写入 scripts/pending_judged.json。每条判定格式：{\"id\": 候选id, \"verdict\": \"yes|no\", \"type\": \"笔试/测评|面试|Offer/录用|宣讲会|投递确认|其他招聘相关\", \"deadline\": \"可选截止时间\", \"reason\": \"判断理由\"}。verdict=yes 的邮件还需判断是否要更新投递进度（总表 招聘邮件汇总.xlsx 的「投递记录进度表」sheet，按公司记录投递/测评/各轮面试时间/结果/链接/备注）：对投递流程有实质推进的邮件（投递确认、笔试/测评、面试、Offer），给出 progress 指令：{\"update\": true, \"company\": \"公司名（与表格一致）\", \"position\": \"岗位（可选）\", \"stage\": \"投递|测评|一面|二面|三面|HR面|Offer|结果\", \"time\": \"该阶段时间（可选，缺省用邮件日期）\", \"link\": \"投递链接（可选）\", \"result\": \"结果（可选，如 ⏳ 进行中 / ✅ Offer）\", \"note\": \"备注（可选）\"}。注意：a) 只有明确是第几轮的面试才填对应 stage，同一轮面试的重复通知邮件 update:false；b) 宣讲会/宣传类邮件不更新进度（update:false 或不给 progress）；c) 邮件日期在 2026-08-01 之前的不要更新进度；d) 公司名务必用与表格一致的规范名称。3) 运行 python3 scripts/record-emails.py 记录结果到表格并应用进度更新；4) 汇报：若有新发现的招聘邮件或即将截止事项，简要汇报内容与截止时间；若没有新邮件或没有需要用户关注的事项，直接回复 NO_REPLY（不要发消息）。",
        "timeoutSeconds": 1800,
        "fallbacks": [
          "custom-maas-coding-api-cn-huabei-1-xf-yun-com/astron-code-latest",
          "deepseek/deepseek-chat"
        ]
      },
      "delivery": {
        "mode": "announce",
        "channel": "feishu",
        "to": "user:YOUR_FEISHU_USER_ID"
      }
    },
    {
      "id": "recruit-email-daily-briefing",
      "name": "招聘邮件每日简报（已迁移系统 crontab，此任务作备选）",
      "enabled": false,
      "schedule": {
        "kind": "cron",
        "expr": "0 9 * * *"
      },
      "description": "每天早上 9:00 汇总表格中的待处理招聘邮件，生成简报发送（已迁移到系统 crontab 直发飞书 API，不经 LLM）",
      "sessionTarget": "isolated",
      "payload": {
        "kind": "agentTurn",
        "message": "运行招聘邮件每日简报：cd <skill-dir> && python3 scripts/email-daily-briefing.py。脚本会生成并打印完整简报（同时保存到简报 txt 文件）。请在回复中【完整转发简报全文内容】（包括待处理概览、各类别详情、截止提醒），不要只写摘要。若简报显示所有邮件都已处理完毕，转发完整的\"全部处理完毕\"简报即可。",
        "timeoutSeconds": 1200
      },
      "delivery": {
        "mode": "announce",
        "channel": "feishu",
        "to": "user:YOUR_FEISHU_USER_ID"
      }
    }
  ]
}
