# OpenClaw 定时任务配置
# 导入方法：openclaw cron import /path/to/this/file
# ⚠️ 请把 user:YOUR_FEISHU_USER_ID 替换为你的飞书用户 ID（config.json 中的 feishu_target）
# ⚠️ 两个任务均使用 isolated 会话 + announce 投递，不要改回 main 会话 systemEvent
#    （main 会话事件依赖 heartbeat 处理，且脚本内调用 openclaw message send 会因会话文件锁失败）

{
  "version": 1,
  "jobs": [
    {
      "id": "recruit-email-hourly-check",
      "name": "招聘邮件检查（Agent 判定）",
      "enabled": true,
      "schedule": {
        "kind": "cron",
        "expr": "0 * * * *",
        "staggerMs": 300000
      },
      "description": "每小时拉取未处理邮件，由 Agent 逐封判断是否为招聘邮件并记录到表格",
      "sessionTarget": "isolated",
      "payload": {
        "kind": "agentTurn",
        "message": "运行招聘邮件监控检查（Agent 判定模式）：1) cd <skill-dir> && python3 scripts/fetch-emails.py 拉取未处理邮件候选；2) 读取 scripts/pending_candidates.json，逐封自行判断是否为招聘邮件（verdict: yes/no；yes 时给出 type: 笔试/测评|面试|Offer/录用|宣讲会|投递确认|其他招聘相关，可提取 deadline 截止时间），写入 scripts/pending_judged.json；3) 运行 python3 scripts/record-emails.py 记录结果到表格；4) 汇报：若有新发现的招聘邮件或即将截止事项，简要汇报内容与截止时间；若没有新邮件或没有需要用户关注的事项，直接回复 NO_REPLY（不要发消息）。",
        "timeoutSeconds": 1800
      },
      "delivery": {
        "mode": "announce",
        "channel": "feishu",
        "to": "user:YOUR_FEISHU_USER_ID"
      }
    },
    {
      "id": "recruit-email-daily-briefing",
      "name": "招聘邮件每日简报",
      "enabled": true,
      "schedule": {
        "kind": "cron",
        "expr": "0 9 * * *"
      },
      "description": "每天早上 9:00 汇总表格中的待处理招聘邮件，生成简报发送",
      "sessionTarget": "isolated",
      "payload": {
        "kind": "agentTurn",
        "message": "运行招聘邮件每日简报：cd <skill-dir> && python3 scripts/email-daily-briefing.py。脚本会生成并打印完整简报（同时保存到 /home/erhao/shared/招聘邮件每日简报.txt）。请在回复中【完整转发简报全文内容】（包括待处理概览、各类别详情、截止提醒），不要只写摘要。若简报显示所有邮件都已处理完毕，转发完整的\"全部处理完毕\"简报即可。",
        "timeoutSeconds": 1200
      },
      "delivery": {
        "mode": "announce",
        "channel": "feishu",
        "to": "user:YOUR_FEISHU_USER_ID"
      }
    }
  ]
}
